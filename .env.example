# Copy to .env and fill in. `dg` loads .env automatically. Never commit .env.

# Absolute path to the static corpus binary on the LXC.
CORPUS_BINARY_PATH=/usr/local/bin/corpus

# Dataset YAML configs (installed bundle on the LXC).
CORPUS_DATASETS_DIR=/usr/local/share/corpus/datasets

# NFS sink the parquet + _INDEX.json + _DONE contract is written to.
CORPUS_SINK_PATH=/mnt/eve

# Serving tier (DB-VM) the `eve-serving load` CLI runs on. Defaults shown; auth
# rides the corpus account's existing SSH key, so no secret here.
# SERVING_HOST=192.168.2.212
# SERVING_USER=serving

# Optional: override partition start dates (default: derived from the dataset
# YAML's gold.served_start). Format YYYY-MM-DD.
# CORPUS_MARKET_HISTORY_GOLD_START=2021-01-01
# CORPUS_MARKET_HISTORY_SILVER_START=2020-01-02

# Local ONNX model dir for `corpus enrich embed` (news-embeddings, corpus ADR-0053):
# a HuggingFace snapshot dir (onnx/model_quantized.onnx + tokenizer.json, ~558 MB).
# Set in the systemd units in PRODUCTION; only needed locally to run the embed asset.
# Absent ⇒ the embed asset fails loud; no other dataset is affected.
# CORPUS_EMBEDDING_MODEL_DIR=/usr/local/share/corpus/models/bge-m3

# Context-dataset secrets (corpus ADR-0047). In PRODUCTION these live ONLY in the
# root-only /etc/eve-industry-orchestration/secrets.env on the LXC (loaded by the
# systemd units), never in the repo. For LOCAL debug corpus reads them from .env —
# put real values in your gitignored .env, only placeholders here. `news` needs no
# secret (its backfill discovers the Contentful token itself, ADR-0049).
# SUPADATA_API_KEY=   # transcripts fetch + backfill
# YOUTUBE_API_KEY=    # transcripts backfill
