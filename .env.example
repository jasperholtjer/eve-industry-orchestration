# Copy to .env and fill in. `dg` loads .env automatically. Never commit .env.

# Absolute path to the static corpus binary on the LXC.
CORPUS_BINARY_PATH=/usr/local/bin/corpus

# Dataset YAML configs (installed bundle on the LXC).
CORPUS_DATASETS_DIR=/usr/local/share/corpus/datasets

# NFS sink the parquet + _INDEX.json + _DONE contract is written to.
CORPUS_SINK_PATH=/mnt/eve

# Optional: override partition start dates (default: derived from the dataset
# YAML's gold.served_start). Format YYYY-MM-DD.
# CORPUS_MARKET_HISTORY_GOLD_START=2021-01-01
# CORPUS_MARKET_HISTORY_SILVER_START=2020-01-02
