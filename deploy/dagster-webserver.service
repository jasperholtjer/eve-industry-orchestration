[Unit]
Description=Dagster webserver (eve-industry-orchestration)
After=network-online.target mnt-eve.mount
Wants=network-online.target

[Service]
Type=simple
User=corpus
Group=988
# TODO: confirm the deploy path the repo is cloned to on the LXC.
WorkingDirectory=/opt/eve-industry-orchestration
Environment=DAGSTER_HOME=/var/lib/dagster
Environment=CORPUS_BINARY_PATH=/usr/local/bin/corpus
Environment=CORPUS_DATASETS_DIR=/usr/local/share/corpus/datasets
Environment=CORPUS_SINK_PATH=/mnt/eve
# Cap rayon below the core count so a UI-launched market-orders Silver run (the
# only rayon parser) leaves 2 cores free on the 8-core box for concurrent Gold /
# light runs. Must match the daemon unit: a Silver run launched from the
# launchpad inherits THIS process's env, not the daemon's. See dagster-daemon.service.
Environment=RAYON_NUM_THREADS=6
# Context-dataset secrets (corpus ADR-0047): SUPADATA_API_KEY, YOUTUBE_API_KEY,
# CONTENTFUL_DELIVERY_TOKEN. Must match the daemon unit — a backfill job launched
# from the launchpad inherits THIS process's env, not the daemon's. Optional (`-`)
# and kept out of the repo; see dagster-daemon.service for the full rationale.
EnvironmentFile=-/etc/eve-industry-orchestration/secrets.env
ExecStart=/opt/eve-industry-orchestration/.venv/bin/dagster-webserver -h 0.0.0.0 -p 3000 -w /opt/eve-industry-orchestration/deploy/workspace.yaml
Restart=on-failure

[Install]
WantedBy=multi-user.target
