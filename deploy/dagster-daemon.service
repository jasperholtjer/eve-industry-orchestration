[Unit]
Description=Dagster daemon (eve-industry-orchestration)
After=network-online.target mnt-eve.mount
Wants=network-online.target

[Service]
Type=simple
User=corpus
Group=988
# TODO: confirm the deploy path the repo is cloned to on the LXC.
WorkingDirectory=/opt/eve-industry-orchestration
Environment=DAGSTER_HOME=/var/lib/dagster
Environment=CORPUS_BINARY_PATH=/usr/local/bin/corpus
Environment=CORPUS_DATASETS_DIR=/usr/local/share/corpus/datasets
Environment=CORPUS_SINK_PATH=/mnt/eve
# Cap rayon below the core count so the one in-flight market-orders Silver run
# (the only rayon parser) leaves headroom: at 6 on an 8-core box it frees 2
# cores for the concurrent `heavy` Gold and single-threaded datasets, so a
# multi-day market-orders backfill cannot monopolise every core. Inherited by
# the `corpus` subprocess via CorpusResource; no-op for non-rayon datasets.
Environment=RAYON_NUM_THREADS=6
# Bound market-orders Silver's resident-snapshot window explicitly. corpus
# >= v0.9.0 parses a window of snapshots in parallel and uses that window as BOTH
# the resident-snapshot cap (its memory peak) and the parse batch size; unset, it
# resolves to `available_parallelism` clamped to [2, 8], so the peak follows the
# host core count and moves silently on the next `pct set 211 --cores`.
# RAYON_NUM_THREADS bounds the thread pool, not the residency. 8 is what the
# 8-core box resolves to today, so pinning it changes nothing that runs — it only
# makes the window a chosen constant. Lowering it is the first lever once
# /sys/fs/cgroup/memory.peak has been reset and read back (see deploy/dagster.yaml
# for the memory budget). Inherited by the `corpus` subprocess via CorpusResource.
Environment=CORPUS_PARSE_CONCURRENCY=8
# Local ONNX weights for `corpus enrich embed` (news-embeddings, corpus ADR-0053):
# a ~558 MB HuggingFace snapshot dir (onnx/model_quantized.onnx + tokenizer.json)
# the operator provisions on the host. Deployment, not contract — never in the
# dataset YAML or the repo. Absent ⇒ the embed asset fails loud (no fallback
# generation); every other dataset is unaffected. Reaches the `corpus` subprocess
# via CorpusResource.embedding_model_dir.
Environment=CORPUS_EMBEDDING_MODEL_DIR=/usr/local/share/corpus/models/bge-m3
# Context-dataset secrets (corpus ADR-0047; Doppler retired, process env is the
# source): SUPADATA_API_KEY (transcripts fetch + backfill) and YOUTUBE_API_KEY
# (transcripts backfill). The `news` dataset needs no secret — its backfill
# discovers the Contentful token from the public site bundle itself (ADR-0049).
# Kept out of the repo — the operator writes them to this root-only host file. The
# `-` prefix makes it optional, so a box without the file still starts: `news` and
# any non-transcript work keep working; `transcripts` fetch/backfill fail loudly at
# runtime if their key is absent. Inherited by the `corpus` subprocess via
# CorpusResource._env().
EnvironmentFile=-/etc/eve-industry-orchestration/secrets.env
ExecStart=/opt/eve-industry-orchestration/.venv/bin/dagster-daemon run -w /opt/eve-industry-orchestration/deploy/workspace.yaml
Restart=on-failure

[Install]
WantedBy=multi-user.target
